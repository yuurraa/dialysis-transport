# Copy to .env.local and supply your project's public values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Leave empty locally to use Vite's /api proxy. Set the backend origin on Render.
VITE_API_URL=
# Google login uses Supabase's configured Google provider; no Google client secret belongs here.
