PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Backend-only, required for trusted route-cache RPCs. Never use in frontend settings.
SUPABASE_SECRET_KEY=

# Backend-only OneMap account; search and driving route APIs require tokens.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Backend-only LTA DataMall subscriber key.
LTA_ACCOUNT_KEY=

# For app login, configure Google OAuth in Supabase's Google provider settings.
# The credentials below are for the separate optional Calendar connection in NestJS.
# Both flows can use the same Google Cloud project, with their respective callback URLs registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# 32 random bytes encoded as 64 hex characters; keep stable and backend-only.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Set false to pause background traffic checks; authorised read-only traffic views remain available.
TRAFFIC_MONITOR_ENABLED=true

# Optional signed-in demo tools; also requires accounts.demo_admin=true for a coordinator.
DEMO_ENABLED=false
